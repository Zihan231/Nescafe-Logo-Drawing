
SESSION_SECRET="change-me-to-a-long-random-string"
NEXT_PUBLIC_SITE_URL=""

# Admin panel (/admin). ADMIN_JWT_SECRET signs admin sign-ins: a long random value, required in production
# (changing it signs every admin out). The super admin is created once from SUPERADMIN_USERNAME/PASSWORD on the
# first sign-in, when no super admin exists yet; after that these two can be removed. Password: 8+ characters.
ADMIN_JWT_SECRET="change-me-to-a-third-long-random-string"
# The secret address of the admin sign-in page: https://<your site>/<ADMIN_LOGIN_PATH>. 8-80 letters, numbers, - or _.
# Make it hard to guess (e.g. staff-8k2q7xw9). /admin/login and /admin then show "page not found" to everyone else.
ADMIN_LOGIN_PATH=""
SUPERADMIN_USERNAME=""
SUPERADMIN_PASSWORD=""
# Optional: the clock the dashboard counts days and hours on (default Asia/Dhaka).
ADMIN_TIMEZONE="Asia/Dhaka"

# Shared with Qr-Photo-Share so only it can check registration codes (use a long random value; same in both apps).
PARTNER_SECRET="change-me-to-another-long-random-string"
# Optional: comma-separated IPs allowed to call /api/partner/verify (leave empty to allow any IP that has the secret).
PARTNER_ALLOWED_IPS=""
